@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center py-5">
    <h1 class="display-4 text-danger fw-bold">403</h1>
    <h3 class="mb-3">Access Denied</h3>
    <p class="text-muted">You do not have permission to perform this action. Only <strong>Admin</strong> users can create, edit, or delete records.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary mt-2">Back to Dashboard</a>
</div>