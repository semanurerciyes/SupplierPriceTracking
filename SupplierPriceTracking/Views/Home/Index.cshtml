@model IEnumerable<SupplierPriceTracking.Models.PriceQuote>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-6 fw-bold">Supplier & Price Tracking Dashboard</h1>
            <p class="text-muted">System Overview & Recent Activities</p>
        </div>
    </div>

    <!-- Özet İstatistik Kartları -->
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white p-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 opacity-75">Total Materials</h6>
                    <h2 class="card-title fw-bold mb-0">@ViewBag.TotalMaterials</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white p-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 opacity-75">Total Suppliers</h6>
                    <h2 class="card-title fw-bold mb-0">@ViewBag.TotalSuppliers</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-dark text-white p-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 opacity-75">Total Quotes Recorded</h6>
                    <h2 class="card-title fw-bold mb-0">@ViewBag.TotalPriceQuotes</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Son Hareketler Tablosu -->
    <div class="card shadow-sm border">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <span class="fw-bold">Recently Added Quotes</span>
            <a asp-controller="PriceQuotes" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Material</th>
                        <th>Supplier</th>
                        <th>Price</th>
                        <th>Currency</th>
                        <th>Valid Until</th>
                        <th>Added Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle fw-semibold">@item.Material?.Name</td>
                                <td class="align-middle">@item.Supplier?.Name</td>
                                <td class="align-middle">@item.Price</td>
                                <td class="align-middle">@item.Currency</td>
                                <td class="align-middle">@item.ValidTo.ToString("dd.MM.yyyy")</td>
                                <td class="align-middle text-muted">@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">No quote records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>