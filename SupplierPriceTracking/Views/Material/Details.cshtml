@model SupplierPriceTracking.Models.Material

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Material</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Code)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Code)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Unit)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Unit)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Category)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Category)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
    </dl>
</div>

<hr />

<h4>Price Quotes</h4>
<table class="table">
    <thead>
        <tr>
            <th>Supplier</th>
            <th>Price</th>
            <th>Currency</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.PriceQuotes != null && Model.PriceQuotes.Any())
        {
            @foreach (var quote in Model.PriceQuotes)
            {
                <tr>
                    <td>@(quote.Supplier != null ? quote.Supplier.Name : quote.SupplierId.ToString())</td>
                    <td>@quote.Price</td>
                    <td>@quote.Currency</td>
                    <td>@quote.CreatedDate.ToString("dd.MM.yyyy")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4">No price quotes available for this material.</td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>