@model IEnumerable<SupplierPriceTracking.Models.PriceQuote>

@{
    ViewData["Title"] = "Price Quotes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Price Quotes</h1>
    <a asp-action="ExportToCsv"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       asp-route-startDate="@ViewData["StartDateFilter"]"
       asp-route-endDate="@ViewData["EndDateFilter"]"
       class="btn btn-success">
        <i class="bi bi-file-earmark-excel"></i> Export to Excel (CSV)
    </a>
</div>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </p>
}

<!-- FİLTRELEME BÖLÜMÜ -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Search Material / Supplier</label>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">Start Date (Valid From)</label>
                    <input type="date" name="startDate" value="@ViewData["StartDateFilter"]" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">End Date (Valid To)</label>
                    <input type="date" name="endDate" value="@ViewData["EndDateFilter"]" class="form-control" />
                </div>

                <div class="col-md-2 d-grid gap-2">
                    <button type="submit" class="btn btn-dark">Apply Filter</button>
                    @if (ViewData["CurrentFilter"] != null || ViewData["StartDateFilter"] != null || ViewData["EndDateFilter"] != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<!-- TABLO -->
<table class="table table-striped table-hover border">
    <thead class="table-light">
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["MaterialSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-startDate="@ViewData["StartDateFilter"]" asp-route-endDate="@ViewData["EndDateFilter"]" class="text-decoration-none text-dark fw-bold">
                    Material ↕
                </a>
            </th>
            <th>Supplier</th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["PriceSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-startDate="@ViewData["StartDateFilter"]" asp-route-endDate="@ViewData["EndDateFilter"]" class="text-decoration-none text-dark fw-bold">
                    Price ↕
                </a>
            </th>
            <th>Currency</th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-startDate="@ViewData["StartDateFilter"]" asp-route-endDate="@ViewData["EndDateFilter"]" class="text-decoration-none text-dark fw-bold">
                    Valid From ↕
                </a>
            </th>
            <th>Valid To</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td class="align-middle">@item.Material?.Name</td>
                    <td class="align-middle">@item.Supplier?.Name</td>
                    <td class="align-middle">@item.Price</td>
                    <td class="align-middle">@item.Currency</td>
                    <td class="align-middle">@item.ValidFrom.ToString("dd.MM.yyyy")</td>
                    <td class="align-middle">@item.ValidTo.ToString("dd.MM.yyyy")</td>
                    <td class="align-middle">
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        }
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-3">No records found.</td>
            </tr>
        }
    </tbody>
</table>

<!-- SAYFALAMA ALANI -->
<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted">
        Page <strong>@ViewBag.PageIndex</strong> of <strong>@ViewBag.TotalPages</strong>
    </div>

    <div>
        <a asp-action="Index"
           asp-route-pageNumber="@(ViewBag.PageIndex - 1)"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           asp-route-startDate="@ViewData["StartDateFilter"]"
           asp-route-endDate="@ViewData["EndDateFilter"]"
           class="btn btn-outline-primary @(ViewBag.HasPreviousPage ? "" : "disabled")">
            &laquo; Previous
        </a>

        <a asp-action="Index"
           asp-route-pageNumber="@(ViewBag.PageIndex + 1)"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           asp-route-startDate="@ViewData["StartDateFilter"]"
           asp-route-endDate="@ViewData["EndDateFilter"]"
           class="btn btn-outline-primary @(ViewBag.HasNextPage ? "" : "disabled")">
            Next &raquo;
        </a>
    </div>
</div>